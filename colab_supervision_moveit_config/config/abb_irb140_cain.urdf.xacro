<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="abb_irb140_cain">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import abb_irb140_cain urdf file -->
    <xacro:include filename="$(find colab_supervision_description)/urdf/irb140.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="abb_irb140_cain.ros2_control.xacro" />


    <xacro:abb_irb140_cain_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
