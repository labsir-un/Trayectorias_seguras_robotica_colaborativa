<?xml version="1.0" ?>

<robot name="abb_irb140_cain" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="materials.xacro"/>
    <xacro:include filename="arm_description.xacro"/>
    <xacro:include filename="end_effector.xacro"/>
    <xacro:include filename="abb_irb140_cain.ros2_control.xacro"/>

    <joint name="end_effector_joint" type="fixed">
        <parent link="tool_link" />
        <child link="prototipe_jsdaleman" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
</robot>