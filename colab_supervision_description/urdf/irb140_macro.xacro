<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="abb_irb140_cain" params="prefix">
    
    <link name="${prefix}base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_base_link.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/base_link.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link_1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_link_1.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="red" />
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/link_1.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link_2">
        <visual>
            <origin xyz="-0.07 0 -0.352" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_link_2.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <origin xyz="-0.07 0 -0.352" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/link_2.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link_3">
        <visual>
            <origin xyz="-0.07 0.065 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_link_3.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="yellow" />
        </visual>
        <collision>
            <origin xyz="-0.07 0.065 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/link_3.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link_4">
        <visual>
            <origin xyz="-0.309 0 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_link_4.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="red" />
        </visual>
        <collision>
            <origin xyz="-0.309 0 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/link_4.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link_5">
        <visual>
            <origin xyz="-0.450 0 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_link_5.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <origin xyz="-0.450 0 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/link_5.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}link_6">
        <visual>
            <origin xyz="-0.515 0 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/visual/obj/irb140_link_6.obj" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="yellow" />
        </visual>
        <collision>
            <origin xyz="-0.515 0 -0.712" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://colab_supervision_description/meshes/collision/link_6.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="${prefix}tool_link" />

    <joint name="${prefix}joint1" type="revolute">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}link_1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.1416" upper="3.1416" effort="0" velocity="3.4906" />
    </joint>

    <joint name="${prefix}joint2" type="revolute">
        <parent link="${prefix}link_1" />
        <child link="${prefix}link_2" />
        <origin xyz="0.070 0 0.352" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-1.5708" upper="1.9199" effort="0" velocity="3.4906" />
    </joint>

    <joint name="${prefix}joint3" type="revolute">
        <parent link="${prefix}link_2" />
        <child link="${prefix}link_3" />
        <origin xyz="0 -0.065 0.360" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-4.0143" upper="0.8727" effort="0" velocity="4.5378" />
    </joint>

    <joint name="${prefix}joint4" type="revolute">
        <parent link="${prefix}link_3" />
        <child link="${prefix}link_4" />
        <origin xyz="0.239 0.065 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit lower="-3.4907" upper="3.4907" effort="0" velocity="6.2831" />
    </joint>

    <joint name="${prefix}joint5" type="revolute">
        <parent link="${prefix}link_4" />
        <child link="${prefix}link_5" />
        <origin xyz="0.141 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-2.0071" upper="2.0071" effort="0" velocity="6.2831" />
    </joint>

    <joint name="${prefix}joint6" type="revolute">
        <parent link="${prefix}link_5" />
        <child link="${prefix}link_6" />
        <origin xyz="0.065 0 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit lower="-6.9813" upper="6.9813" effort="0" velocity="7.8539"/>
    </joint>

    <joint name="${prefix}tool_joint" type="fixed">
        <parent link="${prefix}link_6" />
        <child link="${prefix}tool_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- ROS-Industrial 'base' frame- base_link to ABB World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}base_link"/>
        <child link="${prefix}base"/>
    </joint>

    <!-- ROS-Industrial 'flange' frame- attachment point for EEF models -->
    <link name="${prefix}flange"/>
    <joint type="fixed" name="${prefix}joint_6-flange">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}link_6"/>
        <child link="${prefix}flange"/>
    </joint>

    <!-- ROS-Industrial 'tool0' frame- all-zeros tool frame -->
    <link name="${prefix}tool0" />
    <joint name="${prefix}link_6-tool0" type="fixed">
        <origin xyz="0 0 0" rpy="0 ${radians(90)} 0" />
        <parent link="${prefix}flange" />
        <child link="${prefix}tool0" />
    </joint>

    </xacro:macro>
</robot>
