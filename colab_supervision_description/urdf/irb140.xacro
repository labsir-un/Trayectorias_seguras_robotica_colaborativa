<?xml version="1.0" ?>

<robot name="abb_irb140_cain" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:property name="use_fake_hardware" value="$(arg use_fake_hardware)"/>
  <xacro:arg name="rws_ip" default="None"/>
  <xacro:property name="rws_ip" value="$(arg rws_ip)"/>
  <xacro:arg name="rws_port" default="80"/>
  <xacro:property name="rws_port" value="$(arg rws_port)"/>
  <xacro:arg name="configure_via_rws" default="true"/>
  <xacro:property name="configure_via_rws" value="$(arg configure_via_rws)"/>
  
  <!-- color materials -->
  <xacro:include filename="materials.xacro"/>

  <!-- Robot description -->
  <xacro:include filename="$(find colab_supervision_description)/urdf/irb140_macro.xacro"/>
  <xacro:abb_irb140_cain prefix=""/>

  <!-- end effector -->
  <xacro:include filename="end_effector.xacro"/>
  <joint name="end_effector_joint" type="fixed">
        <parent link="tool_link" />
        <child link="prototipe_jsdaleman" />
        <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ros2_control -->
  <xacro:include filename="$(find colab_supervision_description)/urdf/abb_irb140_driver.ros2_control.xacro" />
  <xacro:abb_ros2_control
    name="ABBMultiInterfaceHardware"
    prefix=""
    use_fake_hardware="${use_fake_hardware}"
    rws_ip="${rws_ip}"
    rws_port="${rws_port}"
    configure_via_rws="${configure_via_rws}"/>
</robot>